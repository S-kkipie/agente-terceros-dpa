# Proveedor de IA (por defecto: openrouter con google/gemini-2.5-flash)
#   openrouter | gemini | openai | anthropic | ollama
TERCEROS_LLM_PROVIDER=openrouter
# https://openrouter.ai/settings/keys (la cuenta necesita créditos cargados)
OPENROUTER_API_KEY=
# Respaldo: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Opcionales
# Vacío = modelo por defecto del proveedor
# TERCEROS_LLM_MODEL=google/gemini-2.5-flash
# Servidor compatible con OpenAI (Groq, LM Studio, vLLM...)
# TERCEROS_LLM_BASE_URL=
# Proveedores de respaldo, en orden
# TERCEROS_LLM_RESPALDO=gemini,ollama
# TERCEROS_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_URL=http://localhost:11434
# TERCEROS_DB=data/terceros.db
